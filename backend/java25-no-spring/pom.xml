<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>walshe.projectcolumbo</groupId>
    <artifactId>supertrend-core-java25</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SuperTrend Core (Java 25, no Spring)</name>
    <description>
        Standalone Java 25 reimplementation of the SuperTrend indicator and its dependent APIs.
        No Spring Framework. Minimal third-party libraries. SOLID principles.
        See openspec/changes/supertrend-core-java25-rewrite/ for the full proposal.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <postgresql.version>42.7.7</postgresql.version>
        <flyway.version>11.8.2</flyway.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <junit.version>6.1.2</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <jackson.version>2.22.1</jackson.version>
        <javalin.version>6.7.0</javalin.version>
        <javalin-openapi.version>6.7.0-1</javalin-openapi.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit-pioneer.version>2.3.0</junit-pioneer.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <dependencies>
        <!-- Postgres JDBC driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- Schema migrations (framework-agnostic, retained per design.md) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Minimal, non-Spring-coupled JDBC connection pool -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>

        <!-- JSON parsing (Binance kline responses) and API response serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- OffsetDateTime (de)serialization for API responses -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- HTTP layer: thin, no DI container/build-time augmentation - see design.md HTTP layer decision -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javalin.community.openapi</groupId>
            <artifactId>javalin-openapi-plugin</artifactId>
            <version>${javalin-openapi.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javalin.community.openapi</groupId>
            <artifactId>javalin-swagger-plugin</artifactId>
            <version>${javalin-openapi.version}</version>
        </dependency>

        <!-- Logging: Javalin/Jetty log their own internals via the SLF4J API - without a binding
             those logs are silently dropped. slf4j-simple is the plain console binding Javalin's
             own startup warning points at; it also replaces our System.Logger/java.util.logging
             call sites, avoiding java.util.logging's MessageFormat-based log(Level, String, Object...)
             (a literal apostrophe in a message gets mangled unless escaped as ''). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Test only -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin-testtools</artifactId>
            <version>${javalin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- junit-pioneer 2.3.0 transitively pulls junit-platform-launcher:1.11.2 (pre-rebrand
             Platform versioning) rather than the 6.x line the rest of this project is on -
             declaring it directly pins it to the same version as everything else, which Maven's
             dependency mediation prefers over the transitive one. Without this, test discovery
             fails outright ("OutputDirectoryCreator not available; probably due to unaligned
             versions of the junit-platform-engine and junit-platform-launcher jars"). -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- @SetEnvironmentVariable/@ClearEnvironmentVariable for env-var-driven config classes
             (IngestionConfig, DataSourceFactory) that are otherwise awkward to unit test -
             System.getenv() has no supported mutation API, so the alternative is refactoring
             every call site to accept an injected env-lookup function just for testability. -->
        <dependency>
            <groupId>org.junit-pioneer</groupId>
            <artifactId>junit-pioneer</artifactId>
            <version>${junit-pioneer.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spins up a real, throwaway Postgres per test class for persistence integration tests -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>supertrend-core</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.javalin.community.openapi</groupId>
                            <artifactId>openapi-annotation-processor</artifactId>
                            <version>${javalin-openapi.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Required by JUnit Pioneer's @SetEnvironmentVariable/@ClearEnvironmentVariable,
                         which mutate the JDK's internal env-var maps via reflection. -->
                    <argLine>--add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>walshe.projectcolumbo.supertrend.Main</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- No Spring Boot repackaging/shading here (see design.md's containerization decision) - this
                 copies runtime-scope dependency jars into target/lib/ so the thin jar above (with its
                 Class-Path manifest entries) is runnable standalone via `java -jar` as long as lib/ sits
                 alongside it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
