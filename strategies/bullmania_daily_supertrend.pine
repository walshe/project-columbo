// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Bullmania Multi-Timeframe Strategy — SuperTrend Edition
// Based on Ivan on Tech Bullmania course rules
// MoneyLine replaced with SuperTrend (ATR 14, Multiplier 1.98)
//
// Supports both Daily and Weekly strategies automatically:
//   Daily  → 2 tranches, 1x ATR stop, +2R partial TP, 2-bar ladder-out
//   Weekly → 3 tranches, 1.0–1.5x ATR stop, +5R/+10R partial TPs, 3-bar ladder-out

//@version=5
strategy(
     "Bullmania Strategy",
     overlay            = true,
     // PYRAMIDING NOTE:
     // Set to 3 (the weekly maximum) even though daily only uses 2 tranches.
     // Pine Script requires pyramiding to be a compile-time constant — it can't
     // change based on the chart timeframe. The strategy auto-detects the timeframe
     // and only enters 2 tranches on daily charts (T3 is skipped). Position sizing
     // divides total risk by the ACTUAL number of tranches for that timeframe
     // (2 for daily, 3 for weekly) so each tranche is correctly sized regardless.
     // Without this, daily tranches would each be 1/3 of risk instead of 1/2.
     pyramiding          = 3,
     close_entries_rule  = "ANY",
     default_qty_type    = strategy.fixed,
     default_qty_value   = 0,
     initial_capital     = 10000,
     currency            = currency.USD,
     commission_type     = strategy.commission.percent,
     commission_value    = 0.1,
     slippage            = 2,
     process_orders_on_close = true,
     calc_on_every_tick  = false
     )

// ─────────────────────────────────────────────────────────────────────────────
// TIMEFRAME DETECTION
// ─────────────────────────────────────────────────────────────────────────────

// Auto-detect whether we're on a weekly chart to switch between rule sets.
// Daily rules: 2 tranches, 1x ATR stop, +2R TP, 2-bar exit ladder
// Weekly rules: 3 tranches, 1.0–1.5x ATR stop, +5R/+10R TPs, 3-bar exit ladder
isWeekly = timeframe.isweekly

// Number of tranches for position sizing — daily uses 2, weekly uses 3.
// This ensures total risk (1R) is split evenly across the correct number
// of entries regardless of the pyramiding=3 compile-time setting.
numTranches = isWeekly ? 3 : 2

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

// — SuperTrend (MoneyLine proxy) —
stPeriod    = input.int(14,    "SuperTrend ATR Period",  minval = 1,  group = "SuperTrend")
stMult      = input.float(1.98, "SuperTrend Multiplier",  minval = 0.1, step = 0.01, group = "SuperTrend")
stSrc       = input.source(hl2, "SuperTrend Source",     group = "SuperTrend")

// — Risk Management —
riskPct     = input.float(1.0,  "Risk Per Campaign (%)", minval = 0.1, step = 0.1, group = "Risk")
atrLen      = input.int(14,     "ATR Length (Stop)",     minval = 1,   group = "Risk")
wklyStopMult = input.float(1.25, "Weekly Stop ATR Mult (1.0–1.5)", minval = 1.0, maxval = 2.0, step = 0.05, group = "Risk",
     tooltip = "Weekly strategy uses 1.0–1.5x ATR for stops. Daily always uses 1x ATR.")

// — Daily Profit Targets —
dlyTpR      = input.float(2.0,  "Daily: Partial TP at R",  minval = 0.5, step = 0.1, group = "Daily Targets")
dlyTpPct    = input.int(50,     "Daily: TP Close %",       minval = 10, maxval = 90, group = "Daily Targets")

// — Weekly Profit Targets (Hybrid R Model — Variation B) —
wklyTp1R    = input.float(5.0,  "Weekly: 1st TP at R",     minval = 1.0, step = 0.5, group = "Weekly Targets",
     tooltip = "Sell one tranche at this R-multiple (Variation B)")
wklyTp2R    = input.float(10.0, "Weekly: 2nd TP at R",     minval = 2.0, step = 0.5, group = "Weekly Targets",
     tooltip = "Sell second tranche at this R-multiple (Variation B)")

// — Common —
beR         = input.float(1.0,  "Breakeven at R",        minval = 0.1, step = 0.1, group = "Common")

// — Chop Filter —
chopMax     = input.int(2,      "Max Failed Campaigns",  minval = 1,   group = "Chop Filter")
chopLookback = input.int(40,    "Chop Lookback (bars)",  minval = 5,   group = "Chop Filter")

// — Direction —
tradeDirInput = input.string("Both", "Trade Direction", options = ["Long", "Short", "Both"], group = "Direction")
allowLong   = tradeDirInput == "Long"  or tradeDirInput == "Both"
allowShort  = tradeDirInput == "Short" or tradeDirInput == "Both"

// — Visuals —
showTable   = input.bool(true,  "Show Info Table",       group = "Visuals")
showLevels  = input.bool(true,  "Show Stop / R Levels",  group = "Visuals")

// ─────────────────────────────────────────────────────────────────────────────
// SUPERTREND CALCULATION (ported from user's v4 indicator)
// ─────────────────────────────────────────────────────────────────────────────

stAtr       = ta.atr(stPeriod)
upBand      = stSrc - stMult * stAtr
upBand1     = nz(upBand[1], upBand)
upBand      := close[1] > upBand1 ? math.max(upBand, upBand1) : upBand

dnBand      = stSrc + stMult * stAtr
dnBand1     = nz(dnBand[1], dnBand)
dnBand      := close[1] < dnBand1 ? math.min(dnBand, dnBand1) : dnBand

var int stTrend = 1
stTrend     := stTrend == -1 and close > dnBand1 ? 1 : stTrend == 1 and close < upBand1 ? -1 : stTrend

bullFlip    = stTrend == 1  and stTrend[1] == -1
bearFlip    = stTrend == -1 and stTrend[1] == 1
stBullish   = stTrend == 1
stBearish   = stTrend == -1

// Plot SuperTrend
plot(stTrend == 1 ? upBand : na, "ST Up",   color.new(color.green, 0), 2, plot.style_linebr)
plot(stTrend == 1 ? na : dnBand, "ST Down",  color.new(color.red, 0),   2, plot.style_linebr)

// ─────────────────────────────────────────────────────────────────────────────
// ATR FOR STOP-LOSS (separate from SuperTrend ATR)
// ─────────────────────────────────────────────────────────────────────────────

// Use the PREVIOUS bar's ATR for stop distance and position sizing.
// This avoids inflated ATR from an extreme breakout candle (the flip bar itself)
// distorting the stop width and shrinking position size for the entire campaign.
dailyATR    = ta.atr(atrLen)[1]
safeATR     = math.max(dailyATR, syminfo.mintick * 10)

// Stop distance: daily = 1x ATR, weekly = user-configurable 1.0–1.5x ATR
stopATRmult = isWeekly ? wklyStopMult : 1.0
stopDist    = safeATR * stopATRmult

// ─────────────────────────────────────────────────────────────────────────────
// STATE VARIABLES
// ─────────────────────────────────────────────────────────────────────────────

// Campaign states:
//   0 = IDLE (no position)
//   1 = T1_ENTERED (waiting for T2 confirmation)
//   2 = T2_ENTERED (weekly only — waiting for T3 confirmation)
//   3 = FULL_POSITION (all tranches placed or ladder-in complete)
//   4 = EXITING (ladder-out in progress)
var int   campState   = 0
var int   campDir     = 0       // 1 = long, -1 = short

var float t1Entry     = na
var float t2Entry     = na
var float t3Entry     = na
var float t1Stop      = na
var float t2Stop      = na
var float t3Stop      = na
var float t1Qty       = na
var float t2Qty       = na
var float t3Qty       = na
var float rValue      = na      // 1R in price terms (= stop distance at entry)

var bool  t1BE        = false   // breakeven activated
var bool  t2BE        = false
var bool  t3BE        = false
var bool  t1TP        = false   // partial TP taken
var bool  t2TP        = false
var bool  t3TP        = false

var int   exitDay     = 0       // ladder-out bar counter
var bool  t1Active    = false
var bool  t2Active    = false
var bool  t3Active    = false
var int   t1EntryBar  = 0       // bar_index when T1 was entered
var int   t2EntryBar  = 0       // bar_index when T2 was entered

// Chop filter
var int   recentFails = 0
var int   lastFailBar = 0

// ─────────────────────────────────────────────────────────────────────────────
// HELPER: POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────

// Total risk (1R) is divided by numTranches so that the FULL ladder equals 1R.
// Daily: 2 tranches → each is 0.5R. Weekly: 3 tranches → each is 0.33R.
// This is why pyramiding=3 doesn't break daily sizing — we divide by 2, not 3.
calcTrancheQty() =>
    float riskAmt    = strategy.equity * riskPct / 100.0
    float totalQty   = riskAmt / stopDist
    float perTranche = totalQty / numTranches
    math.max(perTranche, syminfo.mintick)

// ─────────────────────────────────────────────────────────────────────────────
// CHOP FILTER
// ─────────────────────────────────────────────────────────────────────────────

if bar_index - lastFailBar > chopLookback and recentFails > 0
    recentFails := 0

chopFiltered = recentFails >= chopMax

// ─────────────────────────────────────────────────────────────────────────────
// DETECT CLOSED TRADES (stop-outs / completed exits)
// ─────────────────────────────────────────────────────────────────────────────

var int prevOpenTrades = 0
tradesReduced = strategy.opentrades < prevOpenTrades

if tradesReduced and strategy.closedtrades > 0
    int lastIdx = strategy.closedtrades - 1
    float lastPnl = strategy.closedtrades.profit(lastIdx)
    if lastPnl < 0
        recentFails += 1
        lastFailBar := bar_index

// If all trades closed, reset entire campaign
if strategy.opentrades == 0 and campState != 0
    campState   := 0
    campDir     := 0
    t1Active    := false
    t2Active    := false
    t3Active    := false
    t1BE        := false
    t2BE        := false
    t3BE        := false
    t1TP        := false
    t2TP        := false
    t3TP        := false
    exitDay     := 0
    t1Entry     := na
    t2Entry     := na
    t3Entry     := na
    t1Stop      := na
    t2Stop      := na
    t3Stop      := na
    rValue      := na

prevOpenTrades := strategy.opentrades

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY LOGIC
// ─────────────────────────────────────────────────────────────────────────────

// --- TRANCHE 1: Enter on SuperTrend flip ---
if campState == 0 and not chopFiltered
    if bullFlip and allowLong
        rValue   := stopDist
        t1Qty    := calcTrancheQty()
        t1Entry  := close
        t1Stop   := close - rValue
        campState := 1
        campDir  := 1
        t1Active := true
        t1EntryBar := bar_index
        strategy.entry("Long_T1", strategy.long, qty = t1Qty)
        strategy.exit("XL_T1", "Long_T1", stop = t1Stop)

    else if bearFlip and allowShort
        rValue   := stopDist
        t1Qty    := calcTrancheQty()
        t1Entry  := close
        t1Stop   := close + rValue
        campState := 1
        campDir  := -1
        t1Active := true
        t1EntryBar := bar_index
        strategy.entry("Short_T1", strategy.short, qty = t1Qty)
        strategy.exit("XS_T1", "Short_T1", stop = t1Stop)

// --- TRANCHE 2: Next bar if SuperTrend still confirms ---
if campState == 1 and bar_index > t1EntryBar
    if campDir == 1 and stBullish
        t2Qty    := calcTrancheQty()
        t2Entry  := close
        t2Stop   := close - rValue
        t2Active := true
        t2EntryBar := bar_index
        // Daily: go straight to FULL (state 3). Weekly: wait for T3 (state 2).
        campState := isWeekly ? 2 : 3
        strategy.entry("Long_T2", strategy.long, qty = t2Qty)
        strategy.exit("XL_T2", "Long_T2", stop = t2Stop)

    else if campDir == -1 and stBearish
        t2Qty    := calcTrancheQty()
        t2Entry  := close
        t2Stop   := close + rValue
        t2Active := true
        t2EntryBar := bar_index
        campState := isWeekly ? 2 : 3
        strategy.entry("Short_T2", strategy.short, qty = t2Qty)
        strategy.exit("XS_T2", "Short_T2", stop = t2Stop)

    else
        // SuperTrend flipped against before T2 — manage T1 only
        campState := 3

// --- TRANCHE 3 (Weekly only): Next bar after T2 if SuperTrend still confirms ---
if campState == 2 and isWeekly and bar_index > t2EntryBar
    if campDir == 1 and stBullish
        t3Qty    := calcTrancheQty()
        t3Entry  := close
        t3Stop   := close - rValue
        t3Active := true
        campState := 3
        strategy.entry("Long_T3", strategy.long, qty = t3Qty)
        strategy.exit("XL_T3", "Long_T3", stop = t3Stop)

    else if campDir == -1 and stBearish
        t3Qty    := calcTrancheQty()
        t3Entry  := close
        t3Stop   := close + rValue
        t3Active := true
        campState := 3
        strategy.entry("Short_T3", strategy.short, qty = t3Qty)
        strategy.exit("XS_T3", "Short_T3", stop = t3Stop)

    else
        // SuperTrend flipped against before T3 — manage T1+T2 only
        campState := 3

// ─────────────────────────────────────────────────────────────────────────────
// PROFIT PROTECTION: BREAKEVEN AT +1R
// ─────────────────────────────────────────────────────────────────────────────

if campState == 3 and not na(rValue)
    // Tranche 1
    if t1Active and not t1BE and not na(t1Entry)
        float t1Profit = campDir == 1 ? close - t1Entry : t1Entry - close
        if t1Profit >= rValue * beR
            t1Stop := t1Entry
            t1BE   := true
            if campDir == 1
                strategy.exit("XL_T1", "Long_T1", stop = t1Stop)
            else
                strategy.exit("XS_T1", "Short_T1", stop = t1Stop)

    // Tranche 2
    if t2Active and not t2BE and not na(t2Entry)
        float t2Profit = campDir == 1 ? close - t2Entry : t2Entry - close
        if t2Profit >= rValue * beR
            t2Stop := t2Entry
            t2BE   := true
            if campDir == 1
                strategy.exit("XL_T2", "Long_T2", stop = t2Stop)
            else
                strategy.exit("XS_T2", "Short_T2", stop = t2Stop)

    // Tranche 3 (weekly only)
    if t3Active and not t3BE and not na(t3Entry)
        float t3Profit = campDir == 1 ? close - t3Entry : t3Entry - close
        if t3Profit >= rValue * beR
            t3Stop := t3Entry
            t3BE   := true
            if campDir == 1
                strategy.exit("XL_T3", "Long_T3", stop = t3Stop)
            else
                strategy.exit("XS_T3", "Short_T3", stop = t3Stop)

// ─────────────────────────────────────────────────────────────────────────────
// PARTIAL TAKE PROFIT
// Daily:  close 50% of each tranche at +2R
// Weekly: close T1 at +5R, close T2 at +10R, hold T3 until SuperTrend flip
// ─────────────────────────────────────────────────────────────────────────────

if campState == 3 and not na(rValue)
    if isWeekly
        // --- Weekly Hybrid R Model (Variation B) ---
        // T1: sell entire tranche at +5R
        if t1Active and not t1TP and not na(t1Entry)
            float t1Prof = campDir == 1 ? close - t1Entry : t1Entry - close
            if t1Prof >= rValue * wklyTp1R
                t1TP := true
                if campDir == 1
                    strategy.close("Long_T1", comment = "TP_T1_5R")
                else
                    strategy.close("Short_T1", comment = "TP_T1_5R")
                t1Active := false

        // T2: sell entire tranche at +10R
        if t2Active and not t2TP and not na(t2Entry)
            float t2Prof = campDir == 1 ? close - t2Entry : t2Entry - close
            if t2Prof >= rValue * wklyTp2R
                t2TP := true
                if campDir == 1
                    strategy.close("Long_T2", comment = "TP_T2_10R")
                else
                    strategy.close("Short_T2", comment = "TP_T2_10R")
                t2Active := false

        // T3: held until SuperTrend flip (ladder-out section handles this)

    else
        // --- Daily Hybrid R Model ---
        // Close 50% of each tranche at +2R
        if t1Active and not t1TP and not na(t1Entry)
            float t1Prof = campDir == 1 ? close - t1Entry : t1Entry - close
            if t1Prof >= rValue * dlyTpR
                t1TP := true
                if campDir == 1
                    strategy.close("Long_T1", qty_percent = dlyTpPct, comment = "TP_T1")
                else
                    strategy.close("Short_T1", qty_percent = dlyTpPct, comment = "TP_T1")

        if t2Active and not t2TP and not na(t2Entry)
            float t2Prof = campDir == 1 ? close - t2Entry : t2Entry - close
            if t2Prof >= rValue * dlyTpR
                t2TP := true
                if campDir == 1
                    strategy.close("Long_T2", qty_percent = dlyTpPct, comment = "TP_T2")
                else
                    strategy.close("Short_T2", qty_percent = dlyTpPct, comment = "TP_T2")

// ─────────────────────────────────────────────────────────────────────────────
// LADDER-OUT EXIT: SuperTrend flips against position
// Daily:  exit over 2 consecutive bars
// Weekly: exit over 3 consecutive bars (one tranche per bar)
// ─────────────────────────────────────────────────────────────────────────────

// How many bars to spread the ladder-out exit across
exitBars = isWeekly ? 3 : 2

if campState == 3
    bool flipAgainst = (campDir == 1 and bearFlip) or (campDir == -1 and bullFlip)
    if flipAgainst
        exitDay   := 1
        campState := 4
        // Day/Week 1: close first available tranche
        if campDir == 1
            if t1Active
                strategy.close("Long_T1", comment = "Exit_T1")
                t1Active := false
            else if t2Active
                strategy.close("Long_T2", comment = "Exit_T2")
                t2Active := false
        else
            if t1Active
                strategy.close("Short_T1", comment = "Exit_T1")
                t1Active := false
            else if t2Active
                strategy.close("Short_T2", comment = "Exit_T2")
                t2Active := false

if campState == 4
    bool flipBack = (campDir == 1 and bullFlip) or (campDir == -1 and bearFlip)
    if flipBack
        // SuperTrend flipped back in our favor — cancel exit, hold remaining
        campState := 3
        exitDay   := 0
    else
        exitDay += 1

        // Ladder-out closes exactly ONE tranche per bar:
        //   Daily:  Day 1 → T1, Day 2 → T2
        //   Weekly: Day 1 → T1, Day 2 → T2, Day 3 → T3
        // Each exitDay targets a specific tranche. If that tranche was already
        // closed (e.g., by a TP or stop), it skips to avoid double-closes.

        if exitDay == 2
            // Close T2
            if campDir == 1
                if t2Active
                    strategy.close("Long_T2", comment = "Exit_T2")
                    t2Active := false
            else
                if t2Active
                    strategy.close("Short_T2", comment = "Exit_T2")
                    t2Active := false

            // Daily: also close T3 if somehow active (shouldn't be, but safety)
            if not isWeekly
                if campDir == 1 and t3Active
                    strategy.close("Long_T3", comment = "Exit_T3")
                    t3Active := false
                else if t3Active
                    strategy.close("Short_T3", comment = "Exit_T3")
                    t3Active := false

        if exitDay == 3 and isWeekly
            // Close T3 only
            if campDir == 1
                if t3Active
                    strategy.close("Long_T3", comment = "Exit_T3")
                    t3Active := false
            else
                if t3Active
                    strategy.close("Short_T3", comment = "Exit_T3")
                    t3Active := false

// ─────────────────────────────────────────────────────────────────────────────
// VISUALS: STOP & R-LEVEL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

float plotStop = na
float plotBE   = na
float plotTP1  = na
float plotTP2  = na

if showLevels and campState >= 1 and not na(rValue) and not na(t1Entry)
    if campDir == 1
        plotStop := t1Stop
        plotBE   := t1Entry + rValue * beR
        plotTP1  := t1Entry + rValue * (isWeekly ? wklyTp1R : dlyTpR)
        plotTP2  := isWeekly ? t1Entry + rValue * wklyTp2R : na
    else
        plotStop := t1Stop
        plotBE   := t1Entry - rValue * beR
        plotTP1  := t1Entry - rValue * (isWeekly ? wklyTp1R : dlyTpR)
        plotTP2  := isWeekly ? t1Entry - rValue * wklyTp2R : na

plot(plotStop, "Stop Loss",      color.new(color.red, 0),    1, plot.style_linebr)
plot(plotBE,   "Breakeven (1R)", color.new(color.blue, 60),  1, plot.style_linebr)
plot(plotTP1,  "TP1",            color.new(color.green, 60), 1, plot.style_linebr)
plot(plotTP2,  "TP2 (Weekly)",   color.new(color.teal, 60),  1, plot.style_linebr)

// Entry markers
plotshape(bullFlip and campState[1] == 0 and allowLong  and not chopFiltered, "Long Entry",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(bearFlip and campState[1] == 0 and allowShort and not chopFiltered, "Short Entry", shape.triangledown, location.abovebar, color.red,   size = size.small)

// Chop filter background
bgcolor(chopFiltered ? color.new(color.gray, 90) : na, title = "Chop Filter Active")

// Campaign state background
campColor = campState == 1 ? color.new(color.blue, 93) : campState == 2 ? color.new(color.blue, 90) : campState == 3 ? color.new(color.green, 95) : campState == 4 ? color.new(color.orange, 93) : na
bgcolor(campColor, title = "Campaign State")

// ─────────────────────────────────────────────────────────────────────────────
// INFO TABLE
// ─────────────────────────────────────────────────────────────────────────────

if showTable
    var table infoTbl = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 80), border_width = 1)

    stateStr = campState == 0 ? "IDLE" : campState == 1 ? "LADDER T1" : campState == 2 ? "LADDER T2" : campState == 3 ? "ACTIVE" : "LADDER OUT"
    dirStr   = campDir == 1 ? "LONG" : campDir == -1 ? "SHORT" : "—"
    modeStr  = isWeekly ? "WEEKLY (3T)" : "DAILY (2T)"
    rStr     = not na(rValue) ? str.tostring(rValue, format.mintick) : "—"
    failStr  = str.tostring(recentFails) + " / " + str.tostring(chopMax)

    table.cell(infoTbl, 0, 0, "Mode",       text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 0, modeStr,      text_color = color.aqua, text_size = size.small)
    table.cell(infoTbl, 0, 1, "State",      text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 1, stateStr,     text_color = color.yellow, text_size = size.small)
    table.cell(infoTbl, 0, 2, "Direction",  text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 2, dirStr,       text_color = campDir == 1 ? color.green : campDir == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(infoTbl, 0, 3, "1R Value",   text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 3, rStr,         text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 0, 4, "Fails",      text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 4, failStr,      text_color = recentFails >= chopMax ? color.red : color.white, text_size = size.small)
    table.cell(infoTbl, 0, 5, "T1 BE/TP",   text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 5, (t1BE ? "BE " : "") + (t1TP ? "TP" : ""), text_color = color.green, text_size = size.small)
    table.cell(infoTbl, 0, 6, "T2 BE/TP",   text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 6, (t2BE ? "BE " : "") + (t2TP ? "TP" : ""), text_color = color.green, text_size = size.small)
    table.cell(infoTbl, 0, 7, "T3 BE/TP",   text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 7, isWeekly ? (t3BE ? "BE " : "") + (t3TP ? "TP" : "") : "N/A", text_color = isWeekly ? color.green : color.gray, text_size = size.small)
    table.cell(infoTbl, 0, 8, "Tranches",   text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 8, str.tostring(numTranches), text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 0, 9, "Exit Day",   text_color = color.white, text_size = size.small)
    table.cell(infoTbl, 1, 9, campState == 4 ? str.tostring(exitDay) + " / " + str.tostring(exitBars) : "—", text_color = color.orange, text_size = size.small)

// ─────────────────────────────────────────────────────────────────────────────
// END
// ─────────────────────────────────────────────────────────────────────────────
